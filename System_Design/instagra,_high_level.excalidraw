    {
      "id": "_UIv15tgDE5h-qKb8zlMj",
      "type": "text",
      "x": 552,
      "y": 106.5,
      "width": 1154.37841796875,
      "height": 7575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
